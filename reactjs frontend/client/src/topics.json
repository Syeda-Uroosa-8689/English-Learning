      "title": "Let's Order",
      "subtopics": [
        {
          "id": 1,
          "title": "Describing Foods We Like And Don't Like",
          "type": "lesson",
          "content": {
            "questions": [
              {
                "id": 1,
                "type": "warmup",
                "question": "Hello! I'm Miss Uroosa. Today we are going to talk about foods we like and don't like. First, tell me about yourself.",
                "prompts": [
                  "What is your favourite food?",
                  "What food do you eat most often?",
                  "What food don't you like?",
                  "Why do you like your favourite food?"
                ]
              },
              {
                "id": 2,
                "type": "sorting",
                "question": "Drag every food into the correct basket.",
                "sortingGame": {
                  "foods": [
                    "pizza.jpg",
                    "burger.jpg",
                    "icecream.jpg",
                    "salad.jpg",
                    "curry.jpg",
                    "chocolate.jpg"
                  ],
                  "baskets": [
                    "Like",
                    "Don't Like"
                  ]
                }
              },
              {
                "id": 3,
                "type": "conversation",
                "question": "Let's have a conversation. Imagine you are talking to me in a restaurant. Answer my questions in English.",
                "teacherQuestions": [
                  "What food do you like?",
                  "Why do you like it?",
                  "What food don't you like?",
                  "Why don't you like it?"
                ]
              },
              {
                "id": 4,
                "type": "assessment",
                "question": "Now tell me about your favourite food and the food you don't like. Explain your reasons using complete English sentences."
              }
            ]
          }
        },

        {
          "id": 2,
          "title": "Restaurant Conversations",
          "type": "restaurantConversation",
          "content": {
            "activities": [
              {
                "id": 1,
                "type": "aiWaiter",
                "title": "AI Waiter Chat",
                "intro": {
                  "title": "Meet The AI Waiter",
                  "description": "Practice greeting the waiter and ordering food politely."
                },
                "conversation": [
                  {
                    "teacher": "Welcome to our restaurant! May I take your order?"
                  },
                  {
                    "expected": [
                      "I would like a pizza, please.",
                      "I would like a burger, please.",
                      "Can I have a pizza, please?"
                    ]
                  },
                  {
                    "teacher": "What would you like to drink?"
                  },
                  {
                    "expected": [
                      "Orange juice, please.",
                      "Water, please.",
                      "Coke, please."
                    ]
                  },
                  {
                    "teacher": "Thank you. Your order will be ready soon."
                  }
                ]
              },

              {
                "id": 2,
                "type": "menuMatching",
